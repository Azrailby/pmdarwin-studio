[
 {
  "text": "Kurşun yağarken suya atlasan kurtulur musun?",
  "s": 0.12,
  "e": 2.3,
  "w0": 0,
  "w1": 5
 },
 {
  "text": "Filmlerde hep işe yarıyor.",
  "s": 2.9,
  "e": 4.22,
  "w0": 6,
  "w1": 9
 },
 {
  "text": "Bir deneyde tüfek mermileri suya ateşlendi.",
  "s": 4.76,
  "e": 7.04,
  "w0": 10,
  "w1": 15
 },
 {
  "text": "En hızlı mermiler suya çarptığı anda parçalandı.",
  "s": 7.38,
  "e": 10.14,
  "w0": 16,
  "w1": 22
 },
 {
  "text": "Su onlar için beton gibiydi.",
  "s": 10.54,
  "e": 12.04,
  "w0": 23,
  "w1": 27
 },
 {
  "text": "Bir metre derinlik yetti.",
  "s": 12.37,
  "e": 13.52,
  "w0": 28,
  "w1": 31
 },
 {
  "text": "Ama yavaş tabanca mermileri parçalanmadı.",
  "s": 13.86,
  "e": 16.1,
  "w0": 32,
  "w1": 36
 },
 {
  "text": "İki buçuk metreye kadar tehlikeliydiler.",
  "s": 16.48,
  "e": 18.6,
  "w0": 37,
  "w1": 41
 },
 {
  "text": "Tuhaf ama gerçek:",
