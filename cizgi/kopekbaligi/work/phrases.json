[
 {
  "text": "Bu köpekbalığı yüzerken Osmanlı İmparatorluğu hâlâ ayaktaydı.",
  "s": 0.02,
  "e": 4.265,
  "w0": 0,
  "w1": 6
 },
 {
  "text": "Grönland köpekbalığı,",
  "s": 4.265,
  "e": 5.365,
  "w0": 7,
  "w1": 8
 },
 {
  "text": "Kuzey Atlantik'in buz gibi karanlık sularında yaşıyor.",
