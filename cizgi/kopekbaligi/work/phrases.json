  "e": 21.716,
  "w0": 43,
  "w1": 48
 },
 {
  "text": "Belki beş yüz.",
  "s": 21.716,
  "e": 22.502,
  "w0": 49,
  "w1": 51
 },
 {
  "text": "Ve yavru yapabilmek için yaklaşık yüz elli yaşına gelmesi gerekiyor.",
  "s": 22.502,
  "e": 27.376,
  "w0": 52,
  "w1": 61
 },
 {
  "text": "Yani bugün doğan bir köpekbalığı,",
