[
 {
  "text": "Bu amip burnundan girip beynini yiyor.",
  "s": 0.0,
  "e": 4.766,
  "w0": 0,
  "w1": 5
 },
 {
  "text": "Ilık bir gölde yüzerken burnuna biraz su kaçıyor.",
