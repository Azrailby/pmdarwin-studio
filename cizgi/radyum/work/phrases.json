[
 {
  "text": "Bu kadınlar parlayan boyayı dudaklarıyla sivriltiyordu.",
  "s": 0.022,
  "e": 3.11,
  "w0": 0,
  "w1": 5
 },
 {
  "text": "Ve patronları bunun güvenli olduğunu söylüyordu.",
  "s": 3.37,
  "e": 6.102,
  "w0": 6,
  "w1": 11
 },
 {
  "text": "Bin dokuz yüz yirmili yıllar,",
  "s": 6.417,
  "e": 7.802,
  "w0": 12,
  "w1": 16
 },
 {
  "text": "Amerika.",
  "s": 7.952,
  "e": 8.568,
  "w0": 17,
  "w1": 17
 },
 {
  "text": "Genç kadınlar saat kadranlarını karanlıkta parlayan radyum boyasıyla boyuyordu.",
  "s": 8.848,
  "e": 13.258,
  "w0": 18,
  "w1": 26
 },
 {
  "text": "Fırçanın ucunu inceltmek için dudaklarına alıyorlardı.",
  "s": 13.462,
  "e": 16.443,
  "w0": 27,
  "w1": 32
 },
 {
  "text": "Bazıları eğlenmek için dişlerini ve tırnaklarını bile boyadı.",
  "s": 16.694,
  "e": 19.925,
  "w0": 33,
  "w1": 40
 },
 {
  "text": "Sonra çeneleri çürümeye başladı.",
  "s": 20.158,
  "e": 22.019,
  "w0": 41,
  "w1": 44
 },
 {
  "text": "Bin dokuz yüz yirmi yediye kadar otuzdan fazlası öldü.",
  "s": 22.272,
  "e": 25.397,
  "w0": 45,
  "w1": 53
 },
 {
  "text": "Kadınlar mahkemeye gitti ve kazandı.",
  "s": 25.692,
  "e": 27.738,
  "w0": 54,
  "w1": 58
 },
 {
  "text": "Onların davası,",
  "s": 27.958,
  "e": 28.835,
  "w0": 59,
  "w1": 60
 },
 {
  "text": "bugünkü iş güvenliği kurallarının temeli oldu.",
  "s": 28.985,
  "e": 31.614,
  "w0": 61,
  "w1": 66
 },
 {
  "text": "Tuhaf ama gerçek.",
  "s": 31.919,
  "e": 33.032,
  "w0": 67,
  "w1": 69
 },
 {
  "text": "Her gün.",
  "s": 33.368,
