[
 {
  "text": "Bu adamın beyni cama dönüştü.",
  "s": 0.032,
  "e": 1.846,
  "w0": 0,
  "w1": 4
 },
 {
  "text": "Yıl yetmiş dokuz.",
  "s": 2.123,
  "e": 3.287,
  "w0": 5,
  "w1": 7
 },
 {
  "text": "Vezüv Yanardağı patladı.",
  "s": 3.579,
  "e": 5.114,
  "w0": 8,
  "w1": 10
 },
 {
  "text": "Herkülaneum kentinde genç bir adam yatağında yatarken sıcak bir kül bulutu odayı doldurdu.",
  "s": 5.509,
  "e": 10.795,
  "w0": 11,
  "w1": 23
 },
 {
  "text": "Sıcaklık beş yüz on dereceyi aştı.",
  "s": 11.111,
  "e": 13.266,
  "w0": 24,
  "w1": 29
 },
 {
  "text": "Sonra hızla soğudu.",
  "s": 13.488,
  "e": 14.784,
  "w0": 30,
  "w1": 32
 },
 {
  "text": "Bu ani ısınma ve soğuma,",
  "s": 15.032,
  "e": 16.573,
  "w0": 33,
  "w1": 37
 },
 {
  "text": "beyin dokusunu siyah,",
  "s": 16.723,
  "e": 17.956,
  "w0": 38,
  "w1": 40
 },
 {
  "text": "parlak bir cama çevirdi.",
  "s": 18.106,
  "e": 19.339,
  "w0": 41,
  "w1": 44
 },
 {
  "text": "Bilim insanları içinde hâlâ sinir hücrelerinin izlerini buldu.",
  "s": 19.572,
  "e": 23.375,
  "w0": 45,
  "w1": 52
 },
 {
  "text": "İki bin yıl önceki bir beyin,",
  "s": 23.653,
  "e": 25.118,
  "w0": 53,
  "w1": 58
 },
 {
  "text": "camın içinden bize bakıyor.",
  "s": 25.268,
  "e": 26.733,
  "w0": 59,
  "w1": 62
 },
 {
  "text": "Tuhaf ama gerçek.",
  "s": 27.159,
  "e": 28.285,
  "w0": 63,
  "w1": 65
 },
 {
  "text": "Her gün.",
  "s": 28.581,
  "e": 29.193,
  "w0": 66,
  "w1": 67
 }
]