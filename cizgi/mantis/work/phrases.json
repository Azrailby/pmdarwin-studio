[
 {
  "text": "Bu küçük karides,",
  "s": 0.041,
  "e": 0.967,
  "w0": 0,
  "w1": 2
 },
 {
  "text": "akvaryum camını yumrukla kırabiliyor.",
  "s": 1.117,
  "e": 3.278,
  "w0": 3,
  "w1": 6
 },
 {
  "text": "Adı mantis karidesi.",
  "s": 3.63,
  "e": 4.94,
  "w0": 7,
  "w1": 9
 },
 {
  "text": "Boyu bir avuç kadar.",
  "s": 5.35,
  "e": 6.563,
  "w0": 10,
  "w1": 13
 },
 {
  "text": "Ama ön kollarını bir mermi gibi fırlatıyor.",
  "s": 6.968,
  "e": 9.427,
  "w0": 14,
  "w1": 20
 },
 {
  "text": "Saniyede yirmi üç metre hızla.",
  "s": 9.795,
  "e": 11.726,
  "w0": 21,
  "w1": 25
 },
 {
  "text": "Darbe o kadar hızlı ki,",
  "s": 12.089,
  "e": 13.328,
  "w0": 26,
  "w1": 30
 },
 {
  "text": "suyun içinde minik baloncuklar oluşuyor ve patlıyor.",
  "s": 13.478,
  "e": 16.419,
  "w0": 31,
  "w1": 37
 },
 {
  "text": "Yani av iki kez vuruluyor:",
  "s": 16.814,
  "e": 18.44,
  "w0": 38,
  "w1": 42
 },
 {
  "text": "önce yumrukla,",
  "s": 18.59,
  "e": 19.403,
  "w0": 43,
  "w1": 44
 },
 {
  "text": "sonra patlayan baloncukla.",
  "s": 19.553,
  "e": 21.017,
  "w0": 45,
  "w1": 47
 },
 {
  "text": "Bu baloncuk bir an için binlerce derece ısınıyor.",
  "s": 21.406,
  "e": 24.184,
  "w0": 48,
  "w1": 55
 },
 {
  "text": "Akvaryumcular onu kalın camlı tanklarda tutuyor.",
  "s": 24.546,
  "e": 27.414,
  "w0": 56,
  "w1": 61
 },
 {
  "text": "Çünkü canı sıkılırsa,",
  "s": 27.684,
  "e": 28.823,
  "w0": 62,
  "w1": 64
 },
 {
  "text": "evini kırıp çıkabiliyor.",
  "s": 28.973,
  "e": 30.396,
  "w0": 65,
  "w1": 67
 },
 {
  "text": "Tuhaf ama gerçek.",
  "s": 30.788,
  "e": 31.972,
  "w0": 68,
  "w1": 70
 },
 {
  "text": "Her gün.",
  "s": 32.287,
  "e": 32.889,
  "w0": 71,
  "w1": 72
 }
]